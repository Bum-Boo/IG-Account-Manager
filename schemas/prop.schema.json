{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prop reference asset",
  "type": "object",
  "required": [
    "id",
    "category",
    "source_folder",
    "visual_summary",
    "usable_prompt",
    "name",
    "interaction_prompt",
    "hand_complexity",
    "best_poses",
    "style_tags",
    "avoid",
    "source_note"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "category": { "const": "prop" },
    "source_folder": { "type": "string", "minLength": 1 },
    "source_file": { "type": "string" },
    "visual_summary": { "type": "string", "minLength": 1 },
    "usable_prompt": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "interaction_prompt": { "type": "string", "minLength": 1 },
    "hand_complexity": { "enum": ["low", "medium", "high"] },
    "requires_hand_interaction": { "type": "boolean" },
    "best_poses": { "type": "array", "items": { "type": "string" } },
    "style_tags": { "type": "array", "items": { "type": "string" } },
    "avoid": { "type": "array", "items": { "type": "string" } },
    "source_note": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
