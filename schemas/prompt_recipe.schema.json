{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt recipe",
  "type": "object",
  "required": [
    "account_concept",
    "base_style",
    "model_type",
    "background_id",
    "pose_id",
    "outfit_id",
    "lighting_id",
    "output_targets"
  ],
  "properties": {
    "account_concept": { "type": "string", "minLength": 1 },
    "base_style": { "type": "string", "minLength": 1 },
    "model_type": { "enum": ["female", "male", "neutral"] },
    "background_id": { "type": "string", "minLength": 1 },
    "pose_id": { "type": "string", "minLength": 1 },
    "outfit_id": { "type": "string", "minLength": 1 },
    "prop_id": { "type": "string" },
    "lighting_id": { "type": "string", "minLength": 1 },
    "makeup_hair_id": { "type": "string" },
    "mood_id": { "type": "string" },
    "output_targets": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
